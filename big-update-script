#! /bin/bash

echo "APT" | figlet -f roman
sudo apt update && sudo apt upgrade

echo "SNAP" | figlet -f roman
sudo snap refresh

echo "BREW" | figlet -f roman
brew update && brew outdated
select ANS in 'update' 'stop'; do
    [ $ANS == 'update' ] && { brew upgrade; break; }
    [ $ANS == 'stop' ] && break
done

if which rustup 1>/dev/null; then
    echo "RUST" | figlet -f roman;
    rustup update;
fi
